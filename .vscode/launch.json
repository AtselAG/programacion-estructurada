{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Depurar carpeta (todos los .c)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/main",
      "cwd": "${fileDirname}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "C/C++: gcc build carpeta"
    },
    {
      "name": "Depurar archivo actual",
      "type": "cppdbg",
      "request": "launch",
      "program": "${fileDirname}/${fileBasenameNoExtension}",
      "cwd": "${fileDirname}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "externalConsole": false,
      "setupCommands": [
        { "description": "Pretty printing", "text": "-enable-pretty-printing", "ignoreFailures": true }
      ],
      "preLaunchTask": "C/C++: gcc build active file"
    }
  ]
}
